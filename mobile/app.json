{
  "expo": {
    "name": "Kifaah",
    "slug": "kifaah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kifaah",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kifaah.app"
    },
    "android": {
      "package": "com.kifaah.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#f3f2f2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Kifaah needs access to your photos so you can add a profile picture."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#eaf5ea"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ec3013"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c6b3da07-a3f4-4508-a2ff-bc148ab9b49d"
      }
    },
    "owner": "alzakwaantours"
  }
}
