# PostgreSQL connection string used by Prisma.
# For serverless/high-concurrency deployments, add a `connection_limit` query
# param (e.g. "...?schema=public&connection_limit=5") and put PgBouncer (or
# similar) in front of Postgres — see backend/README.md "Connection pooling".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kifaah?schema=public"

# Separate database for the automated test suite (never point this at your
# dev/prod database — tests truncate tables between runs).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kifaah_test?schema=public"

# Server
PORT=4000
NODE_ENV="development"

# Auth (access token) — the secret itself. Its lifetime (JWT_EXPIRES_IN) and
# the refresh-token lifetime (REFRESH_TOKEN_DAYS) are NOT here anymore — see
# config/default.yaml / config/production.yaml (backend/README.md "Config").
# MUST be set to a long random string in production — the server refuses to
# boot with NODE_ENV=production if this is missing or left at the dev default.
JWT_SECRET="change-this-to-a-long-random-string"

# CORS — comma-separated list of allowed origins, e.g.
# "https://app.kifaah.example,https://admin.kifaah.example"
# REQUIRED in production (server refuses to boot without it there); ignored
# (CORS is permissive) outside production.
ALLOWED_ORIGINS=""

# Twilio Verify — phone+OTP login (CONTRACT §7.1/§7.2).
# Leave all three unset in dev/test to use the built-in ConsoleOtpProvider,
# which prints the OTP code to this server's stdout instead of sending a
# real SMS — no Twilio account needed to develop or test this app.
# ALL THREE are REQUIRED when NODE_ENV=production — the server refuses to
# boot otherwise (the console provider must never run in production).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Sentry error tracking — optional. Leave unset to disable entirely (no-op);
# never fabricate a DSN for local dev.
SENTRY_DSN=""

# Razorpay (test-mode keys only — never put real/live secrets here or in source control)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="rzp_test_secret_xxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="rzp_test_webhook_secret_xxxxxxxxxxxx"

# Uploaded photo storage — a filesystem path, so treated as a deployment
# concern (where this instance's disk/volume is mounted), not a
# dev-vs-production behavioral setting.
UPLOAD_DIR="uploads"

# Optional: override the log level (pino) set by config/*.yaml at runtime,
# without editing/redeploying a config file — e.g. temporarily bump verbosity
# in production. Leave unset to use whatever config/production.yaml or
# config/development.yaml specifies. e.g. "trace" | "debug" | "info" | "warn" | "error"
LOG_LEVEL=""

# ---------------------------------------------------------------------------
# Everything else that used to live here — rate limits, JWT/refresh-token
# lifetimes, the match-engine cron schedule and minimum score, upload
# size/dimension limits, the default log level — is now in config/*.yaml
# (config/default.yaml + config/development.yaml or config/production.yaml,
# selected by NODE_ENV). Those are non-secret behavioral settings, checked
# into git and reviewed like code, not per-deployment secrets — see
# backend/README.md "Config" for the full explanation.
# ---------------------------------------------------------------------------
