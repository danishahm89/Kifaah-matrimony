{
  "name": "kifaah-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Kifaah matrimony app backend — Express + Prisma + PostgreSQL",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^8.36.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.11.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "file-type": "^22.1.0",
    "googleapis": "^178.0.0",
    "helmet": "^7.1.0",
    "js-yaml": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.20.0",
    "razorpay": "^2.9.4",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.0",
    "twilio": "^5.3.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.13.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.12.2",
    "vitest": "^3.2.6"
  }
}
